# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------
# PostgreSQL. SQLite will not work: the ledger needs real constraints and
# triggers, and serverless has no persistent disk.
#
# Supabase (recommended): the runtime URL uses the TRANSACTION POOLER
# (port 6543) so serverless functions can connect; migrations use the
# SESSION POOLER (port 5432) via DIRECT_URL, because the direct
# db.<project-ref>.supabase.co host is IPv6-only and unreachable from
# most machines. Both use the same database password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Supabase API keys (optional — only needed if the app starts calling the
# Supabase REST/Storage APIs directly; Prisma talks straight to Postgres)
# ---------------------------------------------------------------------------
# Publishable key is safe in the browser. Secret/service keys are
# server-only: never commit them, never prefix them with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Authentication — required
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
# Currency owner statements and dashboards are expressed in. GHS or USD.
BASE_CURRENCY="GHS"

# ---------------------------------------------------------------------------
# Payments — Paystack
# ---------------------------------------------------------------------------
# Covers MTN MoMo, Telecel Cash, AirtelTigo Money, Visa and Mastercard in both
# GHS and USD. Leave blank to run in simulation mode: the interface says so,
# and no card is ever charged.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# PayPal is deliberately absent. It has historically been send-only for
# Ghanaian accounts — confirm with PayPal what ABN Homes can actually receive
# before adding an adapter for it.

# ---------------------------------------------------------------------------
# SMS — reminders, receipts and sign-in codes
# ---------------------------------------------------------------------------
# Provider: "arkesel", "hubtel", or "log" to print messages instead of sending.
# With no API key the system runs in simulation mode and records every message
# it would have sent.
SMS_PROVIDER="log"
SMS_API_KEY=""
SMS_SENDER_ID="ABNHomes"
# Hubtel only
SMS_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Protects /api/cron/*. Vercel sends this automatically as a Bearer token when
# the variable is set on the project.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set to 1 to log every Prisma query. Deafening once the ledger is busy.
PRISMA_LOG_QUERIES=""
NEXT_PUBLIC_ANALYTICS_ID=""
