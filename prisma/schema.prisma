// Prisma schema for ABN Homes Company Limited
// Learn more: https://pris.ly/d/prisma-schema
//
// IMPORTANT FOR VERCEL DEPLOYMENT:
// SQLite works locally but NOT on Vercel (serverless = no persistent filesystem).
// Before deploying to Vercel, change provider from "sqlite" to "postgresql"
// and use a Vercel Postgres, Neon, or Supabase connection string for DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // For local development: provider = "sqlite"
  // For Vercel production: provider = "postgresql"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Existing demo models (kept for compatibility)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ABN Homes enquiry submissions from the website contact form
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  interest  String   // Tantra Hill / Sakumono / Nii Ayi Mensah / Custom build / Investment
  message   String
  preferredDate String? // ISO date string for tour booking
  language  String   @default("en") // en | fr
  source    String   @default("website") // website | instagram | tiktok | facebook
  status    String   @default("new") // new | contacted | tour_scheduled | closed | archived
  ipHash    String?  // SHA-256 hash of submitter IP for spam tracking
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([interest])
  @@index([createdAt])
}

// Newsletter subscribers
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("website")
  language  String   @default("en")
  createdAt DateTime @default(now())
}

// Property viewings / tour bookings
model TourBooking {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  property  String   // Tantra Hill / Sakumono / Nii Ayi Mensah
  preferredDate DateTime
  partySize Int      @default(2)
  virtual   Boolean  @default(false) // virtual tour vs in person
  notes     String?
  status    String   @default("requested") // requested | confirmed | completed | cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([preferredDate])
}
